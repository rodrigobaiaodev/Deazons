{
  "crons": [
    {
      "path": "/api/cron-articles",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/sitemap-:name.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(js|css|woff2?|ttf|eot|ico|png|jpg|jpeg|svg|webp|gif|xml|txt|json))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(?!api/)(?!assets/)(?!.*\\.(js|css|woff2?|ttf|eot|ico|png|jpg|jpeg|svg|webp|gif|xml|txt|json))(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Vary", "value": "User-Agent" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(?!api/)(?!assets/)(?!.*\\.(?:js|css|woff2?|ttf|eot|ico|png|jpg|jpeg|svg|webp|gif|xml|txt|json))(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|facebookexternalhit|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Discordbot).*"
        }
      ],
      "dest": "/api/prerender?url=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/sitemap-articles",
      "status": 308,
      "headers": {
        "Location": "/sitemap-articles.xml"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}


