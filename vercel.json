{
  "crons": [
    { "path": "/api/cron-articles", "schedule": "0 10 * * *" },
    { "path": "/api/cron-articles", "schedule": "0 14 * * *" },
    { "path": "/api/cron-articles", "schedule": "0 18 * * *" },
    { "path": "/api/cron-articles", "schedule": "0 22 * * *" },
    { "path": "/api/cron-articles", "schedule": "0 2 * * *"  }
  ],
  "routes": [
    {
      "src": "^/sitemap-articles\\.xml$",
      "dest": "/api/sitemap-articles"
    },
    {
      "src": "^/sitemap(-index|-[a-zA-Z0-9_-]+)?\\.xml$",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8",
        "Cache-Control": "public, max-age=300, stale-while-revalidate=3600"
      },
      "continue": true
    },
    {
      "src": "^/robots\\.txt$",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "continue": true
    },
    {
      "src": "^/assets/.*$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/.*\\.(js|css|woff2?|ttf|eot|ico|png|jpg|jpeg|svg|webp|gif|json)$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "^/(filmes(?:/.*)?|series(?:/.*)?|blog(?:/.*)?|pessoas(?:/.*)?|noticias(?:/.*)?|sobre|privacidade|termos|contato)?$",
      "headers": {
        "Cache-Control": "public, max-age=300, must-revalidate",
        "Vary": "User-Agent"
      },
      "continue": true
    },
    {
      "src": "^/(filmes(?:/.*)?|series(?:/.*)?|blog(?:/.*)?|pessoas(?:/.*)?|noticias(?:/.*)?|sobre|privacidade|termos|contato)?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|bingbot|slurp|duckduckbot|baiduspider|yandexbot|facebookexternalhit|twitterbot|linkedinbot|whatsapp|telegrambot|discordbot|mediapartners-google).*"
        }
      ],
      "dest": "/api/prerender?url=/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
